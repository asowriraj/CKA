QUESTION_TITLE="10. NetworkPolicy for frontend/backend"
CLUSTER_CONTEXT="cluster2"
NAMESPACE=""
MANIFESTS="manifests/q10/frontend-deployment.yaml manifests/q10/backend-deployment.yaml"
ADDITIONAL_SETUP='
mkdir -p ~/netpol
cat > ~/netpol/netpol1.yaml <<EOF
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: netpol-1
  namespace: backend
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: frontend
EOF
'
